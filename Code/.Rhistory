report$site[i],
report$n_total_plethodon[i],
report$n_confirmed_adults[i]))
}
# This code compares Coweeta and Non-Coweeta sites
normalize_site <- function(x) str_to_upper(str_replace_all(x, "\\s+", ""))
site_lookup <- Plethodon_Study_Sites %>%
mutate(site_join = normalize_site(site)) %>%
distinct(site_join, Study.Area)
md_sites <- Plethodon_data %>%
filter(!is.na(site)) %>%
mutate(site_join = normalize_site(site))
amp_sites <- all_mature_plethodon %>%
filter(!is.na(site)) %>%
mutate(site_join = normalize_site(site))
add_area_group <- function(df) {
df %>%
left_join(site_lookup, by = "site_join") %>%
mutate(area_group = case_when(
Study.Area == "Coweeta" ~ "Coweeta",
is.na(Study.Area)       ~ "Unknown",
TRUE                    ~ "Outside Coweeta"
))
}
sites_total <- md_sites %>%
distinct(site_join) %>%
add_area_group() %>%
count(area_group, name = "n_sites") %>%
arrange(factor(area_group, levels = c("Coweeta","Outside Coweeta","Unknown")))
cat("Total number of sites (by area):\n")
for (i in seq_len(nrow(sites_total))) {
cat(sprintf("- %s: %d\n", sites_total$area_group[i], sites_total$n_sites[i]))
}
