y = "Predicted min SVL (mm)",
color = "Sex",
fill = "Sex",
tag = "A") +
theme_classic() +
theme(
legend.position = "none")
Coweeta_Slope_Plot <- ggplot(
Slope_pred_coweeta,
aes(
x = Slope,
y = predicted,
color = group,
fill = group)) +
geom_ribbon(
aes(
ymin = conf.low,
ymax = conf.high),
alpha = 0.2,
color = NA) +
geom_line(linewidth = 1.2) +
coord_cartesian(
xlim = Slope_limits,
ylim = SVL_limits) +
labs(
title = "Coweeta",
x = "Slope",
y = NULL,
color = "Sex",
fill = "Sex",
tag = "B") +
theme_classic() +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
legend.position = "none")
All_Sites_MDVPD_Plot <- ggplot(
MDVPD_pred_all_sites,
aes(
x = MDVPD,
y = predicted,
color = group,
fill = group)) +
geom_ribbon(
