library(tidyverse)
library(ggeffects)
library(ggplot2)
library(patchwork)
Plethodon_data <- read.csv('../Inputs/Plethodon_Data.csv')
Plethodon_Study_Sites <- read.csv('../Inputs/Salamander_Study_Sites.csv')
# This code filters for mature Plethodon and excludes outliers, then provides a summary by site
all_mature_plethodon <- Plethodon_data %>%
filter(maturity_status %in% c("mature_male", "mature_female")) %>%
filter(!is.na(svl_mm)) %>%
mutate(
is_small_outlier = svl_mm < 30,
is_large_outlier = svl_mm > 120,
is_outlier = is_small_outlier | is_large_outlier,
svl_mm = if_else(svl_mm > 120, NA_real_, svl_mm)) %>%
filter(!is_outlier) %>%
select(
site, species, svl_mm, sex, maturity_status)
Plethodon_sites_with_svl <- all_mature_plethodon %>%
group_by(site, maturity_status) %>%
filter(svl_mm == min(svl_mm, na.rm = TRUE)) %>%
ungroup()
Plethodon_sites_simplified <- Plethodon_sites_with_svl %>%
group_by(site, maturity_status) %>%
arrange(svl_mm, species, .by_group = TRUE) %>%
slice_head(n = 1) %>%
ungroup() %>%
select(
site,
maturity_status,
svl_mm) %>%
mutate(
sex = case_when(
maturity_status == "mature_male" ~ "male",
maturity_status == "mature_female" ~ "female"))
Modeling_Data <- Plethodon_Study_Sites %>%
inner_join(Plethodon_sites_simplified, by = "site")
# converting aspect to absolute degree deviations from north to south
Modeling_Data$Aspect <- 180 - abs(Modeling_Data$Aspect - 180)
# standardizing the covariates
Modeling_Data <- Modeling_Data %>%
mutate(
MDT_z  = as.numeric(scale(DaymetMDTC.Apr.Oct.2011.2020, center = TRUE, scale = TRUE)),
MDP_z  = as.numeric(scale(DaymetMDPmm.Apr.Oct.2011.2020, center = TRUE, scale = TRUE)),
MDVPD_z = as.numeric(scale(DaymetMDVPD.Apr.Oct.2011.2020, center = TRUE, scale = TRUE)),
Aspect_z = as.numeric(scale(Aspect)),
Elevation_z = as.numeric(scale(Elevation_m)),
Slope_z = as.numeric(scale(Slope)))
# setting female as base
Modeling_Data$sex <- relevel(factor(Modeling_Data$sex), ref = "male")
# Subsetting data to only Coweeta
Coweeta_Modeling_data <- Modeling_Data %>%
filter(Study.Area == "Coweeta")
# Linear Model
Coweeta_Model <- glm(svl_mm ~ sex + MDVPD_z + Slope_z + Aspect_z + MDP_z + MDT_z, data = Coweeta_Modeling_data)
# Model summary
summary(Coweeta_Model)
# Linear Model
All_Sites_Model <- glm(svl_mm ~ sex + MDVPD_z + Slope_z + Aspect_z + MDP_z + MDT_z, data = Modeling_Data)
# Model summary
summary(All_Sites_Model)
# Back-transformation values
MDVPD_mean <- mean(
Modeling_Data$DaymetMDVPD.Apr.Oct.2011.2020,
na.rm = TRUE)
MDVPD_sd <- sd(
Modeling_Data$DaymetMDVPD.Apr.Oct.2011.2020,
na.rm = TRUE)
Slope_mean <- mean(
Modeling_Data$Slope,
na.rm = TRUE)
Slope_sd <- sd(
Modeling_Data$Slope,
na.rm = TRUE)
# Coweeta predictions
# MDVPD
MDVPD_pred_coweeta <- ggpredict(
Coweeta_Model,
terms = c("MDVPD_z", "sex"))
MDVPD_pred_coweeta$MDVPD <-
MDVPD_pred_coweeta$x * MDVPD_sd + MDVPD_mean
# Slope
Slope_pred_coweeta <- ggpredict(
Coweeta_Model,
terms = c("Slope_z", "sex"))
Slope_pred_coweeta$Slope <-
Slope_pred_coweeta$x * Slope_sd + Slope_mean
# All site predictions
# MDVPD
MDVPD_pred_all_sites <- ggpredict(
All_Sites_Model,
terms = c("MDVPD_z", "sex"))
MDVPD_pred_all_sites$MDVPD <-
MDVPD_pred_all_sites$x * MDVPD_sd + MDVPD_mean
# Slope
Slope_pred_all_sites <- ggpredict(
All_Sites_Model,
terms = c("Slope_z", "sex"))
Slope_pred_all_sites$Slope <-
Slope_pred_all_sites$x * Slope_sd + Slope_mean
# Both MDVPD plots begin and end with the Coweeta prediction range for comparison of the Coweeta plot to the broader regional plot.
MDVPD_limits <- range(
MDVPD_pred_coweeta$MDVPD,
na.rm = TRUE)
Slope_limits <- range(
c(
Slope_pred_coweeta$Slope,
Slope_pred_all_sites$Slope),
na.rm = TRUE)
SVL_limits <- range(
c(
MDVPD_pred_coweeta$conf.low,
MDVPD_pred_coweeta$conf.high,
Slope_pred_coweeta$conf.low,
Slope_pred_coweeta$conf.high,
MDVPD_pred_all_sites$conf.low,
MDVPD_pred_all_sites$conf.high,
Slope_pred_all_sites$conf.low,
Slope_pred_all_sites$conf.high),
na.rm = TRUE)
# Adding some space above and below the confidence intervals
SVL_padding <- diff(SVL_limits) * 0.05
SVL_limits <- c(
SVL_limits[1] - SVL_padding,
SVL_limits[2] + SVL_padding)
Coweeta_MDVPD_Plot <- ggplot(
MDVPD_pred_coweeta,
aes(
x = MDVPD,
y = predicted,
color = group,
fill = group)) +
geom_ribbon(
aes(
ymin = conf.low,
ymax = conf.high),
alpha = 0.2,
color = NA) +
geom_line(linewidth = 1.2) +
coord_cartesian(
xlim = MDVPD_limits,
ylim = SVL_limits) +
labs(
title = "Coweeta",
x = "MDVPD",
y = "Predicted min SVL (mm)",
color = "Sex",
fill = "Sex",
tag = "A") +
theme_classic() +
theme(
legend.position = "none")
Coweeta_Slope_Plot <- ggplot(
Slope_pred_coweeta,
aes(
x = Slope,
y = predicted,
color = group,
fill = group)) +
geom_ribbon(
aes(
ymin = conf.low,
ymax = conf.high),
alpha = 0.2,
color = NA) +
geom_line(linewidth = 1.2) +
coord_cartesian(
xlim = Slope_limits,
ylim = SVL_limits) +
labs(
title = "Coweeta",
x = "Slope",
y = NULL,
color = "Sex",
fill = "Sex",
tag = "B") +
theme_classic() +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
legend.position = "none")
All_Sites_MDVPD_Plot <- ggplot(
MDVPD_pred_all_sites,
aes(
x = MDVPD,
y = predicted,
color = group,
fill = group)) +
geom_ribbon(
aes(
ymin = conf.low,
ymax = conf.high),
alpha = 0.2,
color = NA) +
geom_line(linewidth = 1.2) +
coord_cartesian(
xlim = MDVPD_limits,
ylim = SVL_limits) +
labs(
title = "All sites",
x = "MDVPD",
y = "Predicted min SVL (mm)",
color = "Sex",
fill = "Sex",
tag = "C") +
theme_classic() +
theme(
legend.position = "none")
All_Sites_Slope_Plot <- ggplot(
